# =====================================================================
# PERSONAL AI STOCK INTELLIGENCE & NOTIFICATION SYSTEM (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the filled .env file to version control.
# =====================================================================

# Application Settings
APP_NAME="Personal AI Stock Intelligence"
ENVIRONMENT="production"
DEBUG=false

# Security & Owner Authentication
# Generate a strong 32+ character random key: openssl rand -hex 32
SECRET_KEY="generate-a-secure-random-secret-key-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OWNER_USERNAME="owner"
OWNER_PASSWORD="ReplaceWithAStrongOwnerPassword123!"

# Database Connection
# SQLite (Zero-configuration local setup):
DATABASE_URL="sqlite:///./stock_intel.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://stockuser:stockpass123@localhost:5432/stock_intel"

# Market Data Provider Interface
# Options: "yahoo" (Default real NSE/BSE delayed quotes), "groww" (Official Groww API), "mock" (Test mode)
MARKET_DATA_PROVIDER="yahoo"
DEFAULT_TIMEZONE="Asia/Kolkata"
MARKET_CURRENCY="INR"
STALE_DATA_THRESHOLD_MINUTES=30

# Background Automatic Scanner
AUTO_SCAN_ENABLED=true
SCAN_INTERVAL_MINUTES=15
SCAN_BATCH_SIZE=25
SCAN_MARKET_HOURS_ONLY=false

# Risk Management Controls
MAX_PORTFOLIO_EXPOSURE_PCT=25.0
MAX_SINGLE_STOCK_PCT=10.0
MAX_POSITION_RISK_PCT=2.0
MIN_RISK_REWARD_RATIO=1.5
FUNDS_LOW_THRESHOLD_INR=10000.0

# Groww Trade API Integration (Optional - for broker portfolio & funds sync)
# Documentation: https://groww.in/trade-api/docs/
GROWW_API_AUTH_TOKEN=""
GROWW_API_KEY=""
GROWW_API_SECRET=""
GROWW_TOTP_KEY=""
# SAFETY: Real order execution is disabled by default for capital preservation
GROWW_ORDER_EXECUTION_ENABLED=false

# Firebase Cloud Messaging (FCM Push Notifications to Android)
# Option A: Local file path
FCM_SERVICE_ACCOUNT_PATH=""
# Option B: Cloud hosting environment variable (Paste full raw JSON string from Firebase Console)
FCM_SERVICE_ACCOUNT_JSON=""
NOTIFICATION_COOLDOWN_MINUTES=60
DEFAULT_FCM_DEVICE_TOKEN=""

# AI Analysis & Explainable Investment Thesis Generator
# Google Gemini API key (optional; system includes zero-downtime deterministic quantitative fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_ANALYSIS_ENABLED=true
